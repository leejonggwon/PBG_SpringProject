package kr.spring.entity;

import lombok.Data;

@Data
public class PageMaker {
	
	private Criteria cri; //지금 몇 페이지 보고 있는지 
	                      //한페이지에 몇 개 보여줄지 
	
	private int totalCount; //총 게시글수
	
	private int startPage; //시작페이지번호
	                       //처음구간: 1, 다음구간; 11
	
	private int endPage; // 마지막페이지 번호
	
	private boolean prev; //이전 페이지구간으로 이동하는 버튼표시여부 
	                      //1-10 페이지 보고 있으면 prev = false
	private boolean next;
	
	private int displayPageNum = 10; //하단에 보여줄 페이지 개수
	
	//총게시글 수를 구하는 메서드 
	public void setTotalCount(int totalCount) {
		this.totalCount = totalCount; //총 게시글수
		makePagein();
	}

	//페이징기법
	private void makePagein() {
		//1.
		//마지막페이지 번호 
		// 7/10.0 = 0.7 → 올림 → 1 → 1*10 = 10   
		endPage = (int)(Math.ceil((cri.getPage() / (double)displayPageNum)) * displayPageNum);
		
		//2.
		//시작페이지 번호
		// 20 - 10 + 1 = 11
		startPage =  endPage - displayPageNum + 1 ;
		
	
		if (startPage <= 0) {
			startPage = 1; 
		}
		
		//3.
		//총 페이지수 
		(totalCount/(double)cri.getPerPageNum()
		
		
	}
	
	
	
	
	
	
	
	
	
	
	
	
	
	
}

