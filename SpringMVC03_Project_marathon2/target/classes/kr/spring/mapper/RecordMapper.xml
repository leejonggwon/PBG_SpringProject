<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.spring.mapper.RecordMapper">

	<sql id="search">
		<if test="type=='mrNumber'">
			WHERE MRNUMBER LIKE CONCAT(#{keyword})
		</if>
	</sql>


	<!-- 개인기록조회하기 -->
	<select id="recordList" parameterType="kr.spring.entity.Criteria" resultType="kr.spring.entity.Record"> 
		SELECT * FROM MR_RECORD 
		<include refid="search"/>
		LIMIT #{pageStart}, #{perPageNum}
	</select>
	
	<select id="totalCount" resultType="int" parameterType="kr.spring.entity.Criteria" >
		SELECT COUNT(*) FROM MR_RECORD
		<include refid="search"/>
	</select>
	
	
	</mapper>